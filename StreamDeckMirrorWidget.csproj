<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Versão .NET 10 para o OpenWigiDashManager (branch net10). A main continua em net472 para o
       manager oficial da G.Skill até o Victor decidir descontinuar. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WigiDash.StreamDeckMirrorWidget</RootNamespace>
    <AssemblyName>StreamDeckMirrorWidget</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>2.0.0</Version>
    <Authors>Victor Perez</Authors>
    <Product>Stream Deck Mirror</Product>
    <Description>Espelha o Virtual Device do Elgato Stream Deck no WigiDash (OpenWigiDashManager).</Description>
  </PropertyGroup>

  <!-- O SDK ainda não está no NuGet: por enquanto vem do repo OpenWigiDashManager clonado ao lado. -->
  <PropertyGroup>
    <OpenWigiSdkProject Condition="'$(OpenWigiSdkProject)' == ''">$(MSBuildThisFileDirectory)..\OpenWigiDashManager\src\OpenWigi.Sdk\OpenWigi.Sdk.csproj</OpenWigiSdkProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- Contrato e UI vêm do host (uma cópia só): o plugin compila contra eles mas não leva junto. -->
    <ProjectReference Include="$(OpenWigiSdkProject)" Private="false" ExcludeAssets="runtime" />
    <PackageReference Include="MudBlazor" Version="9.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ferramenta de diagnóstico separada (net472), não faz parte do plugin. -->
    <Compile Remove="TouchDiagnostics\**" />
    <Content Remove="TouchDiagnostics\**" />
    <None Remove="TouchDiagnostics\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" Condition="Exists('icon.png')" />
  </ItemGroup>

</Project>

