<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- Versão .NET 10 para o OpenWigiDashManager. A versão net472, para o manager oficial da G.Skill,
       fica na branch legacy-net472. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>WigiDash.StreamDeckMirrorWidget</RootNamespace>
    <AssemblyName>StreamDeckMirrorWidget</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Authors>Victor Perez</Authors>
    <Product>Stream Deck Mirror</Product>
    <Description>Espelha o Virtual Device do Elgato Stream Deck no WigiDash (OpenWigiDashManager).</Description>
  </PropertyGroup>

  <!-- Pacote de plugin no nuget.org: o SDK monta o .nupkg (packageType OpenWigiDashPlugin, saída em plugin/).
       Enquanto o SDK for preview, a versão do plugin também precisa ser preview (NU5104).
       O workflow de release troca a versão pela da tag (v2.0.0-preview.1 -> 2.0.0-preview.1). -->
  <PropertyGroup>
    <OpenWigiDashPlugin>true</OpenWigiDashPlugin>
    <PackageId>OpenWigiDash.StreamDeckMirror</PackageId>
    <Version>3.0.0-preview.1</Version>
    <Title>Stream Deck Mirror</Title>
    <PackageTags>streamdeck;elgato;wigidash</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageProjectUrl>https://github.com/OpenWigiDash/WigiDash-StreamDeckMirror-WidGet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OpenWigiDash/WigiDash-StreamDeckMirror-WidGet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <!-- O SDK vem do nuget.org. Para testar mudanças no SDK antes de publicar, compile com
       -p:UseLocalOpenWigiSdk=true e o repo OpenWigiDashManager clonado ao lado deste. -->
  <PropertyGroup>
    <OpenWigiSdkVersion>3.0.0-preview.1</OpenWigiSdkVersion>
    <OpenWigiSdkProject Condition="'$(OpenWigiSdkProject)' == ''">$(MSBuildThisFileDirectory)..\OpenWigiDashManager\src\OpenWigi.Sdk\OpenWigi.Sdk.csproj</OpenWigiSdkProject>
  </PropertyGroup>

  <!-- Contrato e UI vêm do host (uma cópia só): o plugin compila contra eles mas não leva junto. -->
  <ItemGroup Condition="'$(UseLocalOpenWigiSdk)' == 'true'">
    <ProjectReference Include="$(OpenWigiSdkProject)" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>
  <!-- Pelo pacote, os targets do SDK (que montam o pacote de plugin) entram sozinhos; pelo projeto local, não. -->
  <Import Project="$([System.IO.Path]::GetDirectoryName('$(OpenWigiSdkProject)'))\build\OpenWigiDash.Sdk.targets"
          Condition="'$(UseLocalOpenWigiSdk)' == 'true'" />
  <ItemGroup Condition="'$(UseLocalOpenWigiSdk)' != 'true'">
    <PackageReference Include="OpenWigiDash.Sdk" Version="$(OpenWigiSdkVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" Version="9.11.0" ExcludeAssets="runtime" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ferramenta de diagnóstico separada (net472), não faz parte do plugin. -->
    <Compile Remove="TouchDiagnostics\**" />
    <Content Remove="TouchDiagnostics\**" />
    <None Remove="TouchDiagnostics\**" />
  </ItemGroup>

  <ItemGroup>
    <None Include="icon.png" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="\" />
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>

